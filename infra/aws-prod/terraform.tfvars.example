# Copiar a terraform.tfvars. El archivo está ignorado por git.
aws_region  = "us-east-2"
aws_profile = "NOMBRE_DEL_PERFIL_AWS"

project_name = "acdan-sat"
environment  = "prod"

# Alertas y admin
alert_email         = "tu-correo@example.com"
contact_admin_email = "contador@acdanconsultores.mx"
email_from_name     = "ACDAN Consultores"

# Correo transaccional. Si usas SES, cambia host/puerto/usuario.
mail_driver     = "smtp"
mail_host       = "smtp.gmail.com"
mail_port       = "587"
mail_username   = "tu-correo@example.com"
mail_password   = "PON_AQUI_LA_CONTRASENA_O_APP_PASSWORD"
mail_encryption = "tls"

# IA para captcha
llm_api_url = "https://api.openai.com"
llm_api_key = "PON_AQUI_TU_API_KEY"
llm_model   = "gpt-4o-mini"

# Presupuesto y operación
# Es una alerta de costo, no un tope de gasto.
budget_limit_usd = "15"
# scheduler_enabled = true

# Dominio propio (opcional).
# El certificado debe vivir en us-east-1 y cubrir ambos dominios.
# portal_domain       = "app.acdan.mx"
# web_domain          = "acdan.mx"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# URLs públicas para CORS y correos. deploy.ps1 las fija después del apply.
# portal_base_url = "https://portal.example.com"
# app_base_url    = "https://portal.example.com"
# web_base_url    = "https://www.example.com"
