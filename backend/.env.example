# ==============================================================================
# ACDAN SAT PLATFORM - PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copiar este archivo a .env y llenar credenciales — NUNCA commitear el .env real
# ==============================================================================

# 1. SERVIDOR HTTP LOCAL Y CORS
PORT=8090
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# 2. AUTENTICACIÓN JWT Y SESIONES DE USUARIO
AUTH_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-seguro
AUTH_JWT_DIAS=7

# 3. BASE DE DATOS DYNAMODB (Local o AWS)
ACDAN_CLIENTES=ACDAN_CLIENTES
ACDAN_JOBS=ACDAN_JOBS
ACDAN_DOCS=ACDAN_DOCS
ACDAN_USERS=ACDAN_USERS
DYNAMO_REGION=us-east-1
DYNAMO_URL=http://localhost:8000
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# 4. KOUPPER MAILING SERVICE PROVIDER (ENVÍO DE EMAILS)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_ENCRYPTION=tls
EMAIL_FROM_NAME=ACDAN Consultores
CONTACT_ADMIN_EMAIL=contador@acdanconsultores.mx
BRAND_LOGO_URL=
NOTIFICAR_EMAILS=true

# 5. COLA DE TRABAJOS KOUPPER SQS (AWS Serverless Jobs)
# Vacío para ejecución local en segundo plano
KQ_SQS_REGION=us-east-1
KQ_SQS_QUEUE_URL=
KQ_SQS_DLQ_URL=

# 6. CUSTODIA DE PDFS (S3 o Disco Local)
# DOCS_DRIVER=file para local, DOCS_DRIVER=s3 para producción en AWS
DOCS_DRIVER=file
S3_BUCKET=acdan-sat-storage
S3_PREFIX=acdan-sat/

# 7. IA CAPTCHA SOLVER (Visión por Consenso para el SAT)
LLM_API_URL=https://api.openai.com
LLM_API_KEY=tu-api-key-de-openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 8. SAT BOT SCRAPING TUNING
SAT_LOGIN_URL=https://loginda.siat.sat.gob.mx/nidp/app/login?id=ciec&sid=0&option=credential&sid=0
SAT_CONSTANCIA_URL=https://wwwmat.sat.gob.mx/app/seg/cont/accesoC?parametro=1&url=/operacion/43824/reimprime-tus-acuses-del-rfc&target=principal&tipoLogeo=c&hostServer=https://wwwmat.sat.gob.mx
SAT_CFDI_URL=https://portalcfdi.facturaelectronica.sat.gob.mx/
SAT_MAX_CAPTCHA_RETRIES=3
SAT_HEADLESS=true
# Hilos del pool local de bots (cada browser ~300-500 MB; el SAT limita paralelos).
SAT_POOL_SIZE=2

# Cierre mensual CFDI: después de terminar el mes en America/Mexico_City.
# Local ejecuta el tick cada hora; en AWS usar la invocación EventBridge existente.
ACDAN_SCHEDULER_ENABLED=true
