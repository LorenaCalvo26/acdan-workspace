# Copiar a .env — nunca commitear el real
PORT=8090
CORS_ORIGINS=http://localhost:5174

# Tablas Dynamo (local o AWS)
ACDAN_CLIENTES=ACDAN_CLIENTES
ACDAN_JOBS=ACDAN_JOBS
ACDAN_DOCS=ACDAN_DOCS
ACDAN_USERS=ACDAN_USERS

# Auth plataforma: secreto para firmar los JWT (cámbialo en producción)
AUTH_JWT_SECRET=cambia-esto-por-un-secreto-largo
AUTH_JWT_DIAS=7

# SQS / jobs (vacío = driver file local)
KQ_SQS_REGION=us-east-1
KQ_SQS_QUEUE_URL=
KQ_SQS_DLQ_URL=

# S3 PDFs (vacío = ./storage local)
DOCS_DRIVER=file
S3_BUCKET=
S3_PREFIX=acdan-sat/

# IA Vision para captcha (OpenAI compatible — reutiliza tu proyecto de imágenes IA)
# Koupper VisionServiceProvider lee LLM_API_URL / LLM_API_KEY / LLM_MODEL
LLM_API_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# SAT bot tuning
SAT_LOGIN_URL=https://loginda.siat.sat.gob.mx/nidp/app/login?id=ciec&sid=0&option=credential&sid=0
SAT_MAX_CAPTCHA_RETRIES=3
SAT_HEADLESS=true

# Mail avisos
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM_NAME=Pilli Contable
CONTACT_ADMIN_EMAIL=contador@acdanconsultores.mx
# Logo (URL https) que se incrusta en los emails; vacío = wordmark de texto
BRAND_LOGO_URL=
# false = deshabilita todos los emails de dictámenes
NOTIFICAR_EMAILS=true
